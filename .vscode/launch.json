{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch main",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "C/C++: g++ build active file",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "source ${workspaceFolder}/mpreal_printer.py" }
            ]
        }
    ]
}
